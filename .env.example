# bowlbot environment variables
# Copy to .env for local development. On Railway, set these in the service's
# Variables tab. Never commit .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Discord bot token.
DISCORD_TOKEN=

# Path to the SQLite database file. The directory is created if missing.
#   Local:   ./data/bowlbot.sqlite            (gitignored)
#   Railway: put it inside the mounted volume, e.g. /data/bowlbot.sqlite,
#            or reference the mount directly:
#            DATABASE_PATH=${{RAILWAY_VOLUME_MOUNT_PATH}}/bowlbot.sqlite
DATABASE_PATH=./data/bowlbot.sqlite

# Public URL of the site, used in the owner's startup DM. Unset locally, so it
# falls back to http://localhost:$PORT.
#   Railway: PUBLIC_URL=https://bowlbot.io
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Railway-injected (do not set these yourself on Railway)
# ---------------------------------------------------------------------------

# PORT - the HTTP port for the website + socket.io server.
# Railway injects it. Locally it defaults to 3000.
# PORT=3000

# RAILWAY_VOLUME_MOUNT_PATH - set automatically when a volume is attached.
# Only useful via the ${{...}} reference in DATABASE_PATH above.

# ---------------------------------------------------------------------------
